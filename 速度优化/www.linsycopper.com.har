id=\"page\" class=\"site\">\n\n<!-- \n\tView: Home Hero\n\t==========================================================================\n\tRobustness Fix: \n\tUsing inline background style instead of child img tag to ensure the image \n\talways follows the container's height without proportional scaling gaps.\n-->\n<section \n\tclass=\"lc-hero relative min-h-screen lg:min-h-screen flex flex-col overflow-hidden bg-neutral-950 bg-center bg-cover bg-no-repeat\"\n\tstyle=\"background-image: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0.60) 100%), url('https://www.linsycopper.com/wp-content/uploads/2026/05/linsy-copper-factory.png');\"\n>\n\t<!-- Content Container (flex-1 ensures it pushes stats to bottom) -->\n\t<div class=\"relative z-10 flex-1 flex flex-col justify-center mx-auto w-full max-w-[1280px] px-4 sm:px-6 lg:px-8 pt-[96px] pb-[32px] sm:pt-[120px] sm:pb-[60px]\">\n\t\t\n\t\t<div class=\"max-w-4xl\">\n\t\t\t<!-- 1. Certifications (Industrial Tags) -->\n\t\t\t\t\t\t\t<div class=\"flex flex-wrap items-center gap-4 mb-8 md:gap-6 md:mb-10\">\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"flex items-center gap-2 font-mono text-[15px] font-bold text-[#F4BD5D]\">\n\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-3.5 h-3.5 shrink-0 opacity-80\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n\t\t\t\t\t\t\tASTM B152 Standard\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"flex items-center gap-2 font-mono text-[15px] font-bold text-[#F4BD5D]\">\n\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-3.5 h-3.5 shrink-0 opacity-80\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n\t\t\t\t\t\t\tRoHS Compliant\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"flex items-center gap-2 font-mono text-[15px] font-bold text-[#F4BD5D]\">\n\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-3.5 h-3.5 shrink-0 opacity-80\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n\t\t\t\t\t\t\tComplete MTR Documentation\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\n\t\t\t<!-- 2. Headline (Machined Impact) -->\n\t\t\t<h1 class=\"!text-[42px] sm:!text-5xl md:!text-7xl lg:!text-[88px] font-bold text-white !leading-[1] tracking-tight text-balance mb-8 text-heading\">\n\t\t\t\t\t\t\t\t\tPremium Copper\t\t\t\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<span class=\"text-[#F97C30]\">&amp; Bronze Alloys</span>\n\t\t\t\t\t\t\t\t\t\t\t\t</h1>\n\n\t\t\t<!-- 3. Description (Clean Industrial) -->\n\t\t\t<p class=\"text-lg md:text-xl text-white/80 leading-relaxed max-w-2xl mb-10 md:mb-12\">\n\t\t\t\tFull range of pure copper, brass &amp; bronze materials. 50+ alloy grades on hand, supporting customized machining and worldwide shipping.<br /><br />\r\n\t\t\t</p>\n\n\t\t\t<!-- 4. CTAs (Action Oriented) -->\n\t\t\t<div class=\"flex flex-wrap gap-5 mb-10 md:mb-16\">\n\t\t\t\t<!-- Primary CTA -->\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\thref=\"https://www.linsycopper.com/contact/\"\n\t\t\t\t\t\ttarget=\"_self\"\n\t\t\t\t\t\tclass=\"lc-hero-btn lc-hero-btn--primary group\"\n\t\t\t\t\t>\n\t\t\t\t\t\tBrowse Products\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-4 h-4 transition-transform group-hover:translate-x-1.5\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n\t\t\t\t\t</a>\n\t\t\t\t\n\t\t\t\t<!-- Secondary CTA (Request a Quote) -->\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\thref=\"https://www.linsycopper.com/contact/\"\n\t\t\t\t\t\ttarget=\"_self\"\n\t\t\t\t\t\tclass=\"lc-hero-btn lc-hero-btn--secondary group\"\n\t\t\t\t\t>\n\t\t\t\t\t\tRequest A Quote\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-4 h-4\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<!-- 5. Stats Dashboard (Anchored to Bottom, Seamless Background) -->\n\t<div class=\"relative z-10 w-full border-t border-white/10 bg-black/20 backdrop-blur-sm\">\n\t\t<div class=\"mx-auto w-full max-w-[1280px] px-4 sm:px-6 lg:px-8 py-6 sm:py-10\">\n\t\t\t\t\t\t\t<div class=\"grid grid-cols-2 sm:grid-cols-4 gap-8 md:gap-16\">\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"group\">\n\t\t\t\t\t\t\t<div class=\"font-mono text-2xl sm:text-3xl md:text-4xl font-bold text-[#F4BD5D] mb-1.5 transition-transform group-hover:scale-105 inline-block\">\n\t\t\t\t\t\t\t\t5000+\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] text-white/50 leading-tight\">\n\t\t\t\t\t\t\t\tTons Ready Stock\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"group\">\n\t\t\t\t\t\t\t<div class=\"font-mono text-2xl sm:text-3xl md:text-4xl font-bold text-[#F4BD5D] mb-1.5 transition-transform group-hover:scale-105 inline-block\">\n\t\t\t\t\t\t\t\tISO9001\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] text-white/50 leading-tight\">\n\t\t\t\t\t\t\t\tCertified Quality\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"group\">\n\t\t\t\t\t\t\t<div class=\"font-mono text-2xl sm:text-3xl md:text-4xl font-bold text-[#F4BD5D] mb-1.5 transition-transform group-hover:scale-105 inline-block\">\n\t\t\t\t\t\t\t\t25 Years+\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] text-white/50 leading-tight\">\n\t\t\t\t\t\t\t\tIndustry Experience\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"group\">\n\t\t\t\t\t\t\t<div class=\"font-mono text-2xl sm:text-3xl md:text-4xl font-bold text-[#F4BD5D] mb-1.5 transition-transform group-hover:scale-105 inline-block\">\n\t\t\t\t\t\t\t\t50+\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] text-white/50 leading-tight\">\n\t\t\t\t\t\t\t\tCopper Grades\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t</div>\n</section>\n\n<!-- \n\tView: Material Grid\n\t==========================================================================\n-->\n<section class=\"bg-white py-16 md:py-24\">\n\t<div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\">\n\t\t\n\t\t<!-- Section Header -->\n\t\t<div class=\"mb-12 text-center\">\n\t\t\t<h2 class=\"text-balance text-3xl font-bold tracking-tight text-[#1F2937] md:text-4xl text-heading\">\n\t\t\t\tBrowse by Material Type\t\t\t</h2>\n\t\t</div>\n\n\t\t<!-- Grid: Material Cards -->\n\t\t\t\t\t<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\thref=\"https://www.linsycopper.com/material/brass/\"\n\t\t\t\t\t\tclass=\"group relative overflow-hidden rounded-sm border border-[#E5E7EB] bg-white transition-all hover:border-[#F97C30] hover:shadow-lg flex flex-col h-full\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<!-- Material Image -->\n\t\t\t\t\t\t<div class=\"relative w-full aspect-[4/3] overflow-hidden bg-[#F2F4F7]\">\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Brass-768x576.png\"\n\t\t\t\t\t\t\t\talt=\"Brass\"\n\t\t\t\t\t\t\t\tclass=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Material Info -->\n\t\t\t\t\t\t<div class=\"p-6 flex flex-col flex-grow text-center items-center\">\n\t\t\t\t\t\t\t<p class=\"text-lg font-bold text-[#0B3570] mb-4 text-center\">\n\t\t\t\t\t\t\t\tBrass\t\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\t\t<!-- CTA Button -->\n\t\t\t\t\t\t\t<div class=\"mt-auto w-full bg-[#F2F4F7] text-[#0B3570] font-semibold py-2 px-4 rounded-sm transition-colors hover:bg-[#0B3570] hover:text-white group-hover:bg-[#0B3570] group-hover:text-white flex items-center justify-center gap-2\">\n\t\t\t\t\t\t\t\tView Details\n\t\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Bottom Accent Bar -->\n\t\t\t\t\t\t<div class=\"h-1 w-0 bg-gradient-to-r from-[#F97C30] to-[#F4BD5D] transition-all duration-300 group-hover:w-full\"></div>\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\thref=\"https://www.linsycopper.com/material/bronze/\"\n\t\t\t\t\t\tclass=\"group relative overflow-hidden rounded-sm border border-[#E5E7EB] bg-white transition-all hover:border-[#F97C30] hover:shadow-lg flex flex-col h-full\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<!-- Material Image -->\n\t\t\t\t\t\t<div class=\"relative w-full aspect-[4/3] overflow-hidden bg-[#F2F4F7]\">\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Bronze-768x576.png\"\n\t\t\t\t\t\t\t\talt=\"Bronze\"\n\t\t\t\t\t\t\t\tclass=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Material Info -->\n\t\t\t\t\t\t<div class=\"p-6 flex flex-col flex-grow text-center items-center\">\n\t\t\t\t\t\t\t<p class=\"text-lg font-bold text-[#0B3570] mb-4 text-center\">\n\t\t\t\t\t\t\t\tBronze\t\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\t\t<!-- CTA Button -->\n\t\t\t\t\t\t\t<div class=\"mt-auto w-full bg-[#F2F4F7] text-[#0B3570] font-semibold py-2 px-4 rounded-sm transition-colors hover:bg-[#0B3570] hover:text-white group-hover:bg-[#0B3570] group-hover:text-white flex items-center justify-center gap-2\">\n\t\t\t\t\t\t\t\tView Details\n\t\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Bottom Accent Bar -->\n\t\t\t\t\t\t<div class=\"h-1 w-0 bg-gradient-to-r from-[#F97C30] to-[#F4BD5D] transition-all duration-300 group-hover:w-full\"></div>\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\thref=\"https://www.linsycopper.com/material/pure-copper/\"\n\t\t\t\t\t\tclass=\"group relative overflow-hidden rounded-sm border border-[#E5E7EB] bg-white transition-all hover:border-[#F97C30] hover:shadow-lg flex flex-col h-full\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<!-- Material Image -->\n\t\t\t\t\t\t<div class=\"relative w-full aspect-[4/3] overflow-hidden bg-[#F2F4F7]\">\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\tsrc=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Pure-Copper-768x576.png\"\n\t\t\t\t\t\t\t\talt=\"Pure Copper\"\n\t\t\t\t\t\t\t\tclass=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Material Info -->\n\t\t\t\t\t\t<div class=\"p-6 flex flex-col flex-grow text-center items-center\">\n\t\t\t\t\t\t\t<p class=\"text-lg font-bold text-[#0B3570] mb-4 text-center\">\n\t\t\t\t\t\t\t\tPure Copper\t\t\t\t\t\t\t</p>\n\n\t\t\t\t\t\t\t<!-- CTA Button -->\n\t\t\t\t\t\t\t<div class=\"mt-auto w-full bg-[#F2F4F7] text-[#0B3570] font-semibold py-2 px-4 rounded-sm transition-colors hover:bg-[#0B3570] hover:text-white group-hover:bg-[#0B3570] group-hover:text-white flex items-center justify-center gap-2\">\n\t\t\t\t\t\t\t\tView Details\n\t\t\t\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<!-- Bottom Accent Bar -->\n\t\t\t\t\t\t<div class=\"h-1 w-0 bg-gradient-to-r from-[#F97C30] to-[#F4BD5D] transition-all duration-300 group-hover:w-full\"></div>\n\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\n\t</div>\n</section>\n\n<script>\nwindow.LC_HOME_INDUSTRY_IMMERSIVE_6a38d1c17c0ed = [{\"bg\":\"https:\\/\\/www.linsycopper.com\\/wp-content\\/uploads\\/2026\\/05\\/Aerospace-Grade-Copper-Alloys.png\",\"kicker\":\"Aerospace\",\"title\":\"Aerospace-Grade Copper Alloys\",\"desc\":\"Success Case: We supplied C17200 beryllium copper components to a leading aerospace manufacturer, improving connector fatigue resistance by 25% and ensuring stable signal transmission under extreme temperature and vibration conditions.\",\"metrics\":[{\"label\":\"Alloy\",\"value\":\"C17200\"},{\"label\":\"Yield Strength\",\"value\":\"\\u22651030 MPa\"}],\"cta_label\":\"Get a Specific Quote\",\"cta_url\":\"\",\"cta_target\":\"_self\"},{\"bg\":\"https:\\/\\/www.linsycopper.com\\/wp-content\\/uploads\\/2026\\/05\\/EV-Grade-Copper-Alloys.png\",\"kicker\":\"Electric Vehicles\",\"title\":\"EV-Grade Copper Alloys\",\"desc\":\"Success Case: We supplied high-conductivity C11000 pure copper busbars to a top European EV manufacturer, successfully reducing terminal heat by 12% under peak load conditions and extending component service life.\",\"metrics\":[{\"label\":\"Alloy\",\"value\":\"C11000\"},{\"label\":\"Purity\",\"value\":\"\\u226599.99%\"}],\"cta_label\":\"Get a Specific Quote\",\"cta_url\":\"\",\"cta_target\":\"_self\"},{\"bg\":\"https:\\/\\/www.linsycopper.com\\/wp-content\\/uploads\\/2026\\/05\\/Marine-Grade-Copper-Alloys.png\",\"kicker\":\"Marine Engineering\",\"title\":\"Marine-Grade Copper Alloys\",\"desc\":\"Success Case: Our naval brass (C46400) components were used in a large-scale offshore project, demonstrating excellent corrosion resistance in saltwater environments and reducing maintenance frequency by 40%.\",\"metrics\":[{\"label\":\"Alloy\",\"value\":\"C46400\"},{\"label\":\"Corrosion Resistance\",\"value\":\"Excellent in saltwater\"}],\"cta_label\":\"Get a Specific Quote\",\"cta_url\":\"\",\"cta_target\":\"_self\"},{\"bg\":\"https:\\/\\/www.linsycopper.com\\/wp-content\\/uploads\\/2026\\/05\\/Industrial-Electrical-Copper.png\",\"kicker\":\"Industrial Electrical\",\"title\":\"Industrial Electrical Copper\",\"desc\":\"Success Case: We provided C2600 brass strips for a global electrical equipment manufacturer, ensuring stable contact performance in high-frequency switching applications and improving product reliability.\",\"metrics\":[{\"label\":\"Alloy\",\"value\":\"C2600\"},{\"label\":\"Electrical Conductivity\",\"value\":\"\\u226528% IACS\"}],\"cta_label\":\"Get a Specific Quote\",\"cta_url\":\"\",\"cta_target\":\"_self\"}];\n</script>\n\n<section class=\"lc-home-industry-immersive relative flex w-full items-center overflow-hidden bg-[#0B3570] pt-[100px] pb-[100px] min-h-[850px] md:min-h-[750px]\" x-data=\"lcHomeIndustryImmersive(window.LC_HOME_INDUSTRY_IMMERSIVE_6a38d1c17c0ed)\" x-init=\"init()\">\n\t<div class=\"absolute inset-0 overflow-hidden\">\n\t\t<template x-for=\"(slide, idx) in slides\" :key=\"idx\">\n\t\t\t<div class=\"lc-home-industry-bg absolute inset-0\" :style=\"slide.bg ? { backgroundImage: 'url(' + slide.bg + ')' } : {}\" x-show=\"idx === currentIndex\" x-transition.opacity.duration.700ms></div>\n\t\t</template>\n\t</div>\n\t<div class=\"absolute inset-0 bg-gradient-to-r from-[#0B3570] via-[#0B3570]/60 to-transparent pointer-events-none\"></div>\n\n\t<div class=\"relative z-10 mx-auto w-full max-w-[1280px] px-4 sm:px-6 lg:px-8\">\n\t\t<div class=\"max-w-2xl text-white\" x-show=\"slides && slides.length\">\n\t\t\t<div class=\"flex items-center gap-2 mb-6\">\n\t\t\t\t<span class=\"lc-home-industry-kicker\" x-text=\"slides[currentIndex] ? slides[currentIndex].kicker : ''\"></span>\n\t\t\t\t<div class=\"h-px w-12 bg-white/30\"></div>\n\t\t\t</div>\n\n\t\t\t<h3 class=\"text-heading lc-home-industry-title mb-6\" x-text=\"slides[currentIndex] ? slides[currentIndex].title : ''\"></h3>\n\n\t\t\t<p class=\"text-lg md:text-xl text-white/80 mb-10 leading-relaxed\" x-text=\"slides[currentIndex] ? slides[currentIndex].desc : ''\"></p>\n\n\t\t\t<div class=\"grid grid-cols-2 gap-8 mb-12 py-6 border-y border-white/10\" x-show=\"slides[currentIndex] && slides[currentIndex].metrics && slides[currentIndex].metrics.length\">\n\t\t\t\t<template x-for=\"(m, mi) in ((slides[currentIndex] && slides[currentIndex].metrics) ? slides[currentIndex].metrics.slice(0, 2) : [])\" :key=\"mi\">\n\t\t\t\t\t<div class=\"flex flex-col\">\n\t\t\t\t\t\t<span class=\"font-mono text-[11px] text-white/55 mb-1\" x-text=\"m.label\"></span>\n\t\t\t\t\t\t<span class=\"font-mono text-2xl font-semibold text-[#F97C30]\" x-text=\"m.value\"></span>\n\t\t\t\t\t</div>\n\t\t\t\t</template>\n\t\t\t</div>\n\n\t\t\t<div class=\"flex flex-col sm:flex-row gap-4\">\n\t\t\t\t<a class=\"lc-home-industry-btn group\" :href=\"(slides[currentIndex] && slides[currentIndex].cta_url) ? slides[currentIndex].cta_url : '#'\" :target=\"(slides[currentIndex] && slides[currentIndex].cta_target) ? slides[currentIndex].cta_target : '_self'\">\n\t\t\t\t\t<span x-text=\"(slides[currentIndex] && slides[currentIndex].cta_label) ? slides[currentIndex].cta_label : 'Get a Specific Quote'\"></span>\n\t\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 ml-2 transition-transform group-hover:translate-x-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n\t\t\t\t\t\t<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" />\n\t\t\t\t\t</svg>\n\t\t\t\t</a>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<button type=\"button\" class=\"lc-home-industry-nav lc-home-industry-nav--next hidden md:flex\" @click=\"next()\" aria-label=\"Next slide\"></button>\n\t<button type=\"button\" class=\"lc-home-industry-nav lc-home-industry-nav--prev hidden md:flex\" @click=\"prev()\" aria-label=\"Previous slide\"></button>\n\n\t<div class=\"lc-home-industry-pagination\">\n\t\t<template x-for=\"(slide, idx) in slides\" :key=\"idx\">\n\t\t\t<button type=\"button\" class=\"lc-home-industry-bullet\" :data-active=\"currentIndex === idx\" @click=\"goTo(idx)\" :aria-label=\"`Go to slide ${idx + 1}`\"></button>\n\t\t</template>\n\t</div>\n</section>\n\n<script>\nfunction lcHomeIndustryImmersive(slides) {\n\treturn {\n\t\tslides: Array.isArray(slides) ? slides : [],\n\t\tcurrentIndex: 0,\n\t\ttimer: null,\n\n\t\tinit() {\n\t\t\tif (!this.slides.length) return;\n\t\t\tthis.start();\n\t\t\tthis.$el.addEventListener('mouseenter', () => this.stop());\n\t\t\tthis.$el.addEventListener('mouseleave', () => this.start());\n\t\t},\n\n\t\tstart() {\n\t\t\tthis.stop();\n\t\t\tthis.timer = setInterval(() => this.next(), 6000);\n\t\t},\n\n\t\tstop() {\n\t\t\tif (this.timer) clearInterval(this.timer);\n\t\t\tthis.timer = null;\n\t\t},\n\n\t\tgoTo(idx) {\n\t\t\tif (!this.slides.length) return;\n\t\t\tconst max = this.slides.length - 1;\n\t\t\tlet nextIdx = Number(idx || 0);\n\t\t\tif (nextIdx < 0) nextIdx = 0;\n\t\t\tif (nextIdx > max) nextIdx = max;\n\t\t\tthis.currentIndex = nextIdx;\n\t\t},\n\n\t\tnext() {\n\t\t\tif (!this.slides.length) return;\n\t\t\tthis.currentIndex = (this.currentIndex + 1) % this.slides.length;\n\t\t},\n\n\t\tprev() {\n\t\t\tif (!this.slides.length) return;\n\t\t\tthis.currentIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;\n\t\t},\n\t};\n}\n</script>\n\n<section class=\"bg-[rgb(248,250,252)] pt-[100px] pb-16 md:pb-24\">\n    <div class=\"mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8\">\n        \n        <!-- Section Header -->\n        <div class=\"mb-4 flex items-end justify-between\">\n            <div>\n                                    <h2 class=\"text-heading text-3xl font-bold text-[#1F2937] md:text-4xl\">\n                        Find Copper Materials by Form                    </h2>\n                            </div>\n            \n                            <a href=\"#\" \n                   class=\"lc-home-viewall-btn hidden items-center rounded-sm border-2 px-6 py-2 font-semibold transition-all md:flex\">\n                    View All Shapes →\n                </a>\n                    </div>\n\n                    <p class=\"mb-12 max-w-2xl text-base leading-relaxed text-[#6B7280]\">\n                Every form factor available in our complete inventory. Select your preferred shape to browse available grades and specifications.            </p>\n        \n        <!-- Shape Grid -->\n        <div class=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n                            <a href=\"https://www.linsycopper.com/shape/copper-bar/\" \n                   class=\"group relative overflow-hidden rounded-sm border border-[#E5E7EB] bg-white transition-all hover:border-[#F97C30] hover:shadow-lg flex flex-col\">\n                    \n                    <!-- Image Section - Top Half -->\n                    <div class=\"aspect-[4/3] w-full overflow-hidden bg-gray-100\">\n                                                    <img width=\"768\" height=\"576\" src=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Copper-Bar-1-768x576.png\" class=\"h-full w-full object-cover transition-transform duration-500 group-hover:scale-105\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://www.linsycop