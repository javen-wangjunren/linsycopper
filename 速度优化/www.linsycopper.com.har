t\t\t\t\t\t\t<div class=\"flex w-full h-full p-0 items-center justify-center\">\n\t\t\t\t\t\t\t\t<img width=\"724\" height=\"1024\" src=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-724x1024.png\" class=\"w-full h-full object-contain\" alt=\"\" loading=\"lazy\" decoding=\"async\" srcset=\"https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-724x1024.png 724w, https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-212x300.png 212w, https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-768x1086.png 768w, https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-1086x1536.png 1086w, https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-1448x2048.png 1448w, https://www.linsycopper.com/wp-content/uploads/2026/05/Linsy-Copper-SGS-scaled.png 1811w\" sizes=\"auto, (max-width: 724px) 100vw, 724px\" />\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\t\t\t<div class=\"swiper-button-next\"></div>\n\t\t\t<div class=\"swiper-button-prev\"></div>\n\t\t\t<div class=\"swiper-pagination\"></div>\n\t\t</div>\n\t</div>\n</section>\n\n<script>\n\t(function() {\n\t\tconst rootId = 'lc-certifications-24cedc8b';\n\n\t\tconst init = () => {\n\t\t\tconst root = document.getElementById(rootId);\n\t\t\tif (!root || !window.Swiper) return false;\n\t\t\tif (root.dataset.swiperInit === '1') return true;\n\n\t\t\troot.dataset.swiperInit = '1';\n\n\t\t\tnew Swiper(root, {\n\t\t\t\tslidesPerView: 1,\n\t\t\t\tspaceBetween: 20,\n\t\t\t\tloop: true,\n\t\t\t\tautoplay: { delay: 5000 },\n\t\t\t\tpagination: { el: root.querySelector('.swiper-pagination'), clickable: true },\n\t\t\t\tnavigation: { nextEl: root.querySelector('.swiper-button-next'), prevEl: root.querySelector('.swiper-button-prev') },\n\t\t\t\twatchOverflow: true,\n\t\t\t\tgrabCursor: true,\n\t\t\t\tbreakpoints: {\n\t\t\t\t\t640: { slidesPerView: 2, spaceBetween: 24 },\n\t\t\t\t\t1024: { slidesPerView: 3, spaceBetween: 28 },\n\t\t\t\t\t1280: { slidesPerView: 4, spaceBetween: 32 }\n\t\t\t\t}\n\t\t\t});\n\n\t\t\treturn true;\n\t\t};\n\n\t\tif (init()) return;\n\n\t\twindow.addEventListener('load', () => {\n\t\t\tif (init()) return;\n\n\t\t\tlet tries = 0;\n\t\t\tconst timer = setInterval(() => {\n\t\t\t\ttries += 1;\n\t\t\t\tif (init() || tries >= 20) {\n\t\t\t\t\tclearInterval(timer);\n\t\t\t\t}\n\t\t\t}, 250);\n\t\t});\n\t})();\n</script>\n\n<!-- Phase 3: View (Pure Output) -->\n<section id=\"lc-review-b6d3309b\" class=\"lc-review bg-white pt-[100px] pb-24 overflow-hidden\">\n    <div class=\"mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8\">\n\n        <!-- Section Header + Navigation -->\n        <div class=\"mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n            <div class=\"max-w-2xl\">\n                <h2 class=\"text-heading text-balance text-3xl font-bold leading-tight md:text-4xl lg:text-5xl\">\n                    Trusted by Industry Leaders                </h2>\n                \n                                    <p class=\"mt-6 text-pretty text-lg leading-relaxed text-[#6B7280]\">\n                        Real feedback from procurement and engineering professionals across industries.                    </p>\n                            </div>\n\n            <!-- Navigation Arrows (Industrial Precision) -->\n            <div class=\"flex gap-3\">\n                <button class=\"review-prev group flex h-12 w-12 items-center justify-center rounded-sm border-2 border-[#E5E7EB] transition-all hover:border-[#0B3570] hover:bg-[#0B3570] hover:text-white active:scale-95\" aria-label=\"Previous review\">\n                    <span class=\"!text-[18px] leading-none font-mono transition-transform group-hover:-translate-x-1\">&lt;</span>\n                </button>\n                <button class=\"review-next group flex h-12 w-12 items-center justify-center rounded-sm border-2 border-[#E5E7EB] transition-all hover:border-[#0B3570] hover:bg-[#0B3570] hover:text-white active:scale-95\" aria-label=\"Next review\">\n                    <span class=\"!text-[18px] leading-none font-mono transition-transform group-hover:translate-x-1\">&gt;</span>\n                </button>\n            </div>\n        </div>\n\n        <!-- Carousel Wrapper (Snap-swipe enabled) -->\n        <div class=\"review-carousel flex gap-6 lg:gap-8 overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth -mx-4 px-4 md:mx-0 md:px-0\">\n            \n                            <div class=\"group relative flex flex-col shrink-0 w-[88%] md:w-[46%] lg:w-[31.5%] snap-center overflow-hidden rounded-sm border border-[#E5E7EB] bg-white p-8 transition-all hover:border-[#F97C30] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]\">\n                    \n                    <!-- Decorative Quote Icon -->\n                    <div class=\"mb-8\">\n                        <svg class=\"h-8 w-8 text-[#F97C30]/20 transition-colors group-hover:text-[#F97C30]/40\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H12.017V21H14.017ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H7.017C6.46472 8 6.017 8.44772 6.017 9V12C6.017 12.5523 5.56929 13 5.017 13H3.017V21H5.017Z\" />\n                        </svg>\n                    </div>\n                    \n                    <blockquote class=\"flex-1 text-lg leading-relaxed text-[#1F2937] italic\">\n                        &ldquo;We&#039;ve been sourcing C17200 beryllium copper from this supplier for our aerospace components for over 3 years. The material consistency is exceptional, with every shipment meeting ASTM B194 specifications.\r\n&rdquo;\n                    </blockquote>\n                    \n                    <div class=\"mt-10 flex items-center gap-4 border-t border-[#F3F4F6] pt-8\">\n                                                    <div class=\"h-14 w-14 shrink-0 rounded-full bg-gray-100 flex items-center justify-center grayscale\">\n                                <svg class=\"h-8 w-8 text-gray-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                            </div>\n                                                \n                        <div class=\"flex-1 min-w-0\">\n                            <div class=\"font-bold text-lg text-[#1F2937] truncate\">David Morrison</div>\n                            <div class=\"font-mono text-[11px] uppercase tracking-wider text-[#6B7280] truncate\">\n                                Chief Procurement Officer                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Action Color Accent Bar -->\n                    <div class=\"absolute bottom-0 left-0 h-[2px] w-0 bg-[#F97C30] transition-all duration-500 group-hover:w-full\"></div>\n                </div>\n                            <div class=\"group relative flex flex-col shrink-0 w-[88%] md:w-[46%] lg:w-[31.5%] snap-center overflow-hidden rounded-sm border border-[#E5E7EB] bg-white p-8 transition-all hover:border-[#F97C30] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]\">\n                    \n                    <!-- Decorative Quote Icon -->\n                    <div class=\"mb-8\">\n                        <svg class=\"h-8 w-8 text-[#F97C30]/20 transition-colors group-hover:text-[#F97C30]/40\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H12.017V21H14.017ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H7.017C6.46472 8 6.017 8.44772 6.017 9V12C6.017 12.5523 5.56929 13 5.017 13H3.017V21H5.017Z\" />\n                        </svg>\n                    </div>\n                    \n                    <blockquote class=\"flex-1 text-lg leading-relaxed text-[#1F2937] italic\">\n                        &ldquo;The 24-hour quote turnaround and consistent delivery schedule has made our production planning much more efficient. Their technical team helped us select the optimal naval brass grade for our marine hardware.\r\n&rdquo;\n                    </blockquote>\n                    \n                    <div class=\"mt-10 flex items-center gap-4 border-t border-[#F3F4F6] pt-8\">\n                                                    <div class=\"h-14 w-14 shrink-0 rounded-full bg-gray-100 flex items-center justify-center grayscale\">\n                                <svg class=\"h-8 w-8 text-gray-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                            </div>\n                                                \n                        <div class=\"flex-1 min-w-0\">\n                            <div class=\"font-bold text-lg text-[#1F2937] truncate\">Jennifer Chen</div>\n                            <div class=\"font-mono text-[11px] uppercase tracking-wider text-[#6B7280] truncate\">\n                                Supply Chain Director                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Action Color Accent Bar -->\n                    <div class=\"absolute bottom-0 left-0 h-[2px] w-0 bg-[#F97C30] transition-all duration-500 group-hover:w-full\"></div>\n                </div>\n                            <div class=\"group relative flex flex-col shrink-0 w-[88%] md:w-[46%] lg:w-[31.5%] snap-center overflow-hidden rounded-sm border border-[#E5E7EB] bg-white p-8 transition-all hover:border-[#F97C30] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]\">\n                    \n                    <!-- Decorative Quote Icon -->\n                    <div class=\"mb-8\">\n                        <svg class=\"h-8 w-8 text-[#F97C30]/20 transition-colors group-hover:text-[#F97C30]/40\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H12.017V21H14.017ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H7.017C6.46472 8 6.017 8.44772 6.017 9V12C6.017 12.5523 5.56929 13 5.017 13H3.017V21H5.017Z\" />\n                        </svg>\n                    </div>\n                    \n                    <blockquote class=\"flex-1 text-lg leading-relaxed text-[#1F2937] italic\">\n                        &ldquo;Working with their engineering team on our custom copper busbar project was impressive. They provided detailed electrical conductivity data and helped optimize our specifications for cost and performance.\r\n&rdquo;\n                    </blockquote>\n                    \n                    <div class=\"mt-10 flex items-center gap-4 border-t border-[#F3F4F6] pt-8\">\n                                                    <div class=\"h-14 w-14 shrink-0 rounded-full bg-gray-100 flex items-center justify-center grayscale\">\n                                <svg class=\"h-8 w-8 text-gray-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                            </div>\n                                                \n                        <div class=\"flex-1 min-w-0\">\n                            <div class=\"font-bold text-lg text-[#1F2937] truncate\">Michael Zhang</div>\n                            <div class=\"font-mono text-[11px] uppercase tracking-wider text-[#6B7280] truncate\">\n                                Senior Electrical Engineer                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Action Color Accent Bar -->\n                    <div class=\"absolute bottom-0 left-0 h-[2px] w-0 bg-[#F97C30] transition-all duration-500 group-hover:w-full\"></div>\n                </div>\n                            <div class=\"group relative flex flex-col shrink-0 w-[88%] md:w-[46%] lg:w-[31.5%] snap-center overflow-hidden rounded-sm border border-[#E5E7EB] bg-white p-8 transition-all hover:border-[#F97C30] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]\">\n                    \n                    <!-- Decorative Quote Icon -->\n                    <div class=\"mb-8\">\n                        <svg class=\"h-8 w-8 text-[#F97C30]/20 transition-colors group-hover:text-[#F97C30]/40\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H12.017V21H14.017ZM5.017 21L5.017 18C5.017 16.8954 5.91243 16 7.017 16H10.017C10.5693 16 11.017 15.5523 11.017 15V9C11.017 8.44772 10.5693 8 10.017 8H7.017C6.46472 8 6.017 8.44772 6.017 9V12C6.017 12.5523 5.56929 13 5.017 13H3.017V21H5.017Z\" />\n                        </svg>\n                    </div>\n                    \n                    <blockquote class=\"flex-1 text-lg leading-relaxed text-[#1F2937] italic\">\n                        &ldquo;Their extensive stock of standard grades means we can get materials quickly for urgent projects. The packaging quality ensures materials arrive in perfect condition. True B2B efficiency.\r\n&rdquo;\n                    </blockquote>\n                    \n                    <div class=\"mt-10 flex items-center gap-4 border-t border-[#F3F4F6] pt-8\">\n                                                    <div class=\"h-14 w-14 shrink-0 rounded-full bg-gray-100 flex items-center justify-center grayscale\">\n                                <svg class=\"h-8 w-8 text-gray-300\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                            </div>\n                                                \n                        <div class=\"flex-1 min-w-0\">\n                            <div class=\"font-bold text-lg text-[#1F2937] truncate\">Robert Williams</div>\n                            <div class=\"font-mono text-[11px] uppercase tracking-wider text-[#6B7280] truncate\">\n                                Operations Manager                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Action Color Accent Bar -->\n                    <div class=\"absolute bottom-0 left-0 h-[2px] w-0 bg-[#F97C30] transition-all duration-500 group-hover:w-full\"></div>\n                </div>\n            \n        </div>\n    </div>\n</section>\n\n<script>\n    (function() {\n        const container = document.getElementById('lc-review-b6d3309b');\n        if (!container) return;\n\n        const carousel = container.querySelector('.review-carousel');\n        const nextBtn = container.querySelector('.review-next');\n        const prevBtn = container.querySelector('.review-prev');\n\n        if (!carousel || !nextBtn || !prevBtn) return;\n\n        const getScrollAmount = () => {\n            const firstCard = carousel.querySelector('div');\n            return firstCard ? firstCard.offsetWidth + 32 : 300;\n        };\n\n        nextBtn.addEventListener('click', () => {\n            carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });\n        });\n\n        prevBtn.addEventListener('click', () => {\n            carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });\n        });\n    })();\n</script>\n\n<section class=\"lc-blog-list bg-[#F2F4F7] pt-[100px] pb-24 overflow-hidden\">\n    <div class=\"max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <!-- Header Section -->\n        <div class=\"mb-16 text-center\">\n            <h2 class=\"text-heading text-balance text-3xl font-bold text-[#1F2937] md:text-4xl lg:text-5xl\">\n                Technical Resources &amp; Insights            </h2>\n        </div>\n\n        <!-- Blog Grid / Mobile Slider -->\n        <div class=\"flex md:grid gap-6 md:gap-8 md:grid-cols-2 lg:grid-cols-3 overflow-x-auto md:overflow-visible snap-x snap-mandatory no-scrollbar pb-8 md:pb-0 -mx-4 px-4 md:mx-0 md:px-0\">\n                            <article class=\"group flex flex-col min-w-[85%] md:min-w-0 snap-center overflow-hidden rounded-sm border border-[#E5E7EB] bg-white transition-all hover:border-[#0B3570] hover:shadow-xl\">\n                    \n                    <!-- Featured Image (Machined Edge) -->\n                    <a href=\"https://www.linsycopper.com/hello-world/\" class=\"relative block h-56 w-full overflow-hidden bg-gray-200\">\n                                                    <div class=\"w-full h-full bg-slate-200 flex items-center justify-center text-slate-400\">\n                                <svg class=\"w-12 h-12\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\"></path></svg>\n                            </div>\n                                                <!-- Reflection Overlay -->\n                        <div class=\"absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none\"></div>\n                    </a>\n\n                    <!-- Content Body -->\n                    <div class=\"flex flex-1 flex-col justify-between p-6\">\n                        <div>\n                            <!-- Meta Info (font-mono) -->\n                            <div class=\"mb-4 flex items-center gap-3 font-mono text-[13px] text-[#6B7280]\">\n                                <time class=\"font-medium\">\n                                    Dec 3, 2025                                </time>\n                                <span class=\"text-[#D1D5DB]\">•</span>\n                                <span class=\"font-medium\">\n                                    1 min read                                </span>\n                                <span class=\"rounded-full bg-[#0B3570] px-3 py-0.5 text-[13px] uppercase font-bold text-white\">\n                                    Uncategorized                                </span>\n                            </div>\n\n                            <!-- Title -->\n                            <h3 class=\"mb-3 text-xl font-bold leading-snug text-[#1F2937] transition-colors group-hover:text-[#0B3570]\">\n                                <a href=\"https://www.linsycopper.com/hello-world/\" class=\"text-heading\">\n                                    Hello world!                                </a>\n                            </h3>\n\n                            <!-- Excerpt -->\n                            <p class=\"line-clamp-3 text-sm text-[#6B7280] leading-relaxed\">\n                                Welcome to WordPress. This is your first post. Edit or delete it, then start writing!                            </p>\n                        </div>\n\n                        <!-- Author Info (Bottom) -->\n                        <div class=\"mt-8 border-t border-[#E5E7EB] pt-5\">\n                            <div class=\"flex items-center gap-3\">\n                                <div class=\"h-10 w-10 overflow-hidden rounded-full border border-[#E5E7EB] bg-slate-50\">\n                                    <img\n                                        src=\"https://secure.gravatar.com/avatar/6e1deb606007675f04d845abcb7952b2a6d5ff93e52e48a774001b54f415c611?s=96&#038;d=mm&#038;r=g\"\n                                        alt=\"Javen\"\n                                        class=\"h-full w-full object-cover\"\n                                    />\n                                </div>\n                                <div>\n                                    <p class=\"text-sm font-bold text-[#1F2937] leading-none mb-1\">Javen</p>\n                                    <p class=\"font-mono text-[10px] uppercase tracking-wider text-[#F97C30]\">Specialist</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                    </div>\n\n        <!-- View All CTA -->\n        <div class=\"mt-16 text-center\">\n            <a href=\"https://www.linsycopper.com\" \n               class=\"lc-blog-list__cta\">\n                VIEW ALL ARTICLES →\n            </a>\n        </div>\n    </div>\n</section>\n\n<style>\n.no-scrollbar::-webkit-scrollbar { display: none; }\n.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n.lc-blog-list .lc-blog-list__cta{\n    display:inline-block;\n    border-radius:0.5rem;\n    border:2px solid #0B3570;\